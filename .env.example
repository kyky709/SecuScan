# Variables d'environnement de SecuScan — toutes facultatives.
# Copier ce fichier en `.env.local` pour le développement ; sur Vercel, les saisir dans
# Project Settings → Environment Variables.

# Adresse publique du site (métadonnées, sitemap). Sur Vercel, déduite automatiquement si vide.
NEXT_PUBLIC_SITE_URL=

# Adresse du dépôt de code affichée dans l'interface.
NEXT_PUBLIC_REPOSITORY_URL=

# Adresse ajoutée au User-Agent du scanner, pour que les sites analysés sachent qui les contacte.
SCANNER_CONTACT_URL=

# Limitation de débit partagée entre toutes les instances (Redis Upstash, intégration
# « Upstash for Redis » de la Vercel Marketplace). Sans ces variables : limitation en mémoire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
